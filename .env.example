# Copy to .env and fill in. Never commit .env.

# --- Database / broker (defaults match docker-compose) ---
DATABASE_URL=postgresql+psycopg://aidetector:aidetector@localhost:5432/aidetector
REDIS_URL=redis://localhost:6379/0

# --- Secrets vault ---
# Fernet key used to encrypt uploaded API credentials at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# --- AI cascade ---
# Who plans/adjudicates: deepseek (default — DeepSeek only, no claude CLI or
# .venv-ai needed) or anthropic (Opus via the Claude Agent SDK, WITH_AI=1).
PLANNER_PROVIDER=deepseek
# Planner + adjudicator when PLANNER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required only if your API key is identity-linked (workspace-scoped).
ANTHROPIC_WORKSPACE_ID=
PLANNER_MODEL=claude-opus-5
# Executor (DeepSeek, OpenAI-compatible). Leave base URL as-is for hosted API,
# or point at a self-hosted vLLM endpoint to keep target data in-house.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EXECUTOR_MODEL=deepseek-chat

# --- App ---
ENV=dev
# Host interface docker compose publishes ports on. Loopback by default: the
# API is unauthenticated unless API_KEYS is set, and Redis has no password, so
# a LAN-facing broker lets anyone queue a scan. The vulnerable target stays on
# loopback whatever this is set to.
BIND_HOST=127.0.0.1
# Host ports for Postgres and the web UI, when 5432/3000 are taken by another
# project. The API's CORS origin follows WEB_HOST_PORT; point DATABASE_URL
# (host-side tools) at POSTGRES_HOST_PORT too.
# POSTGRES_HOST_PORT=5432
# WEB_HOST_PORT=3000
# Hours a password sign-in stays valid. Create the admin with `make admin
# email=you@example.com`; once they exist, the keyless open API closes.
SESSION_HOURS=12
# Sign-in/sign-up brute-force limits (failed sign-ins per email and per client
# address within the window; sign-up requests per client address per window).
AUTH_LOGIN_FAILURES_PER_EMAIL=10
AUTH_LOGIN_FAILURES_PER_IP=50
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_SIGNUPS_PER_IP=5
AUTH_SIGNUP_WINDOW_SECONDS=3600
# Maximum core/Kali request rate for each running scan. Scan configuration can
# pick a lower value, but cannot raise this deployment-wide ceiling.
ENGINE_REQUESTS_PER_SECOND=10

# --- Out-of-band (OAST) confirmation — opt-in, off unless set ---
# Self-hosted interactsh-server domain the worker's payloads call back to.
# Also give the worker image the interactsh-client binary (Dockerfile build arg
# WITH_INTERACTSH=1) and run `docker compose --profile oob up interactsh`.
# Real callbacks require public DNS delegation for OAST_DOMAIN to the server.
OAST_SERVER=
OAST_TOKEN=
OAST_DOMAIN=oast.local

# --- OWASP ZAP (opt-in per run via `zap: true`) ---
# Base URL of a running ZAP daemon; run `make up-zap`. Inside compose the
# worker reaches it by service name: http://zap:8090. ZAP scans OUTSIDE the
# engine's 750-request budget and cancellation model.
ZAP_BASE_URL=
ZAP_API_KEY=changeme

# --- Worker-side adjunct tools (opt-in, off unless set) ---
# sqlmap confirmation of SQLi leads and testssl.sh deep TLS audit run in the
# worker image. Bake them in at build time — compose passes the flag through:
#   WITH_KALI_TOOLS=1 make up        # or up-all / up-zap / up-kali
# then set:
#   SQLMAP_BIN=sqlmap        # re-tests flagged SQLi params, bounded targets
#   TESTSSL_BIN=testssl      # HTTPS targets only (Debian's binary name)
SQLMAP_BIN=
TESTSSL_BIN=

# --- Kali adjunct service (opt-in per run via `kali: true`) ---
# nuclei templates + ffuf endpoint discovery; run `make up-kali`. Inside
# compose the worker reaches it by service name: http://kali:8091. Runs
# OUTSIDE the engine's 750-request budget and cancellation model, like ZAP.
KALI_BASE_URL=
KALI_API_KEY=changeme

# --- Premium PostgreSQL schema context ---
# Nothing to set here: the server never connects to a target database. Schema
# context is a schema: block in a project's aidetector.yml, read on the CLI
# machine by `aidetector --local` (docs/database-schema-context.md).

# --- Infrastructure monitoring: passive AWS WAF evidence ---
# Salt for pseudonymous client and identifier hashes. Set once and keep it stable.
MONITORING_HMAC_KEY=
# Log groups the worker may read, as ARNs (the console's trailing ":*" is fine).
# Reads sign with the worker's AWS credential chain, so no keys live in the app:
# locally `AWS_PROFILE=<profile> make up-aws` mounts ~/.aws read-only; in
# production use a task, pod or instance role. The identity needs only
# logs:FilterLogEvents on these log groups.
MONITORING_AWS_LOG_GROUPS=
# Bounds for collecting one day.
MONITORING_AWS_MAX_EVENTS=5000000
MONITORING_AWS_MAX_CALLS=20000
MONITORING_COLLECT_SECONDS=1800
# Hourly windows read at once (CloudWatch allows 5 FilterLogEvents requests/s).
MONITORING_AWS_CONCURRENCY=4
# Events sampled per day: the newest of each UTC hour, split evenly. 0 = whole day.
MONITORING_AWS_SAMPLE_EVENTS=20000

# --- Infrastructure monitoring: load balancer response metrics (optional) ---
# WAF logs record what the WAF decided, not what the app answered. An Application Load
# Balancer's CloudWatch metrics add that per hour: target 2XX/3XX/4XX/5XX, ELB 4XX/5XX,
# rejected connections and response time. No access logging is needed. Approve each
# ALB here by ARN; the worker's identity needs cloudwatch:GetMetricData.
MONITORING_AWS_LOAD_BALANCERS=arn:aws:elasticloadbalancing:us-west-2:257498453293:loadbalancer/app/pd-app-prod-lb/a97ab14f613ad63c
# Ceiling for one day's read; also clamped to the time the collection task has left.
MONITORING_ALB_COLLECT_SECONDS=60

# --- Monitoring AI explanations (optional): Cursor SDK + read-only GitHub MCP ---
# Build the Cursor runtime into the images with: WITH_CURSOR=1 make up
MONITORING_AI_PROVIDER=none
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Ceiling for one explanation; reading a repository takes many MCP calls.
MONITORING_AI_TIMEOUT_SECONDS=600
# Each monitor brings its own GitHub repository and a fine-grained token with
# Contents: read-only on that repository, entered in the monitor form and stored
# encrypted. That token's scope is the boundary; the MCP read-only header only
# narrows the tool list.

# --- Local runner (the CLI heavy lane) ---
# Lets `aidetector run --local` execute a scan on the CLI machine and upload the
# result. Off by default; the claim route 404s until it is on. Build the runner
# image once with `make runner-image`.
LOCAL_RUNNER_ENABLED=false

# --- Heavy-lane bounded agent (CLI `run --local --agent`) ---
# The agent drives sandboxed tools (nuclei/ffuf/sqlmap) in hardened throwaway
# containers. OFF by default: it needs a Docker endpoint reachable from the
# runner, and mounting the Docker socket into the runner is deliberately not
# done. With this unset the `--agent` pass still runs (source annotation,
# memory, loop bookkeeping) but no sandboxed tool executes — a clean no-op.
# Set it (and give the runner a Docker endpoint) to enable the tools.
AGENT_SANDBOX_ENABLED=false
