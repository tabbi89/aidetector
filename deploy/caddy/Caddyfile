# aidetector.com — the one public entry point. Web on /, the API on /api.
#
# The site sits behind Cloudflare's proxy. The client address is taken from
# CF-Connecting-IP only when the TCP peer is a Cloudflare edge (the ranges
# below, from cloudflare.com/ips), so a request sent straight to the origin IP
# cannot pick its own address. The API's sign-in throttle buckets on it.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
		Content-Security-Policy-Report-Only "default-src 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Powered-By
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			# Overwrite, never append: the API trusts this header as-is.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The CLI's server is https://aidetector.com, not .../api: its requests
	# (User-Agent runpentests-cli/… or legacy aidetector-cli/…) go to the API at the root. Paths under
	# /api stay with handle_path above, which strips the prefix first.
	@cli {
		header_regexp User-Agent ^(runpentests|aidetector)-cli/
		not path /api/*
	}
	handle @cli {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
