  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.28",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
